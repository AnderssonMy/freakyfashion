<h1>Varukorgen</h1>

<% if (empty) { %>
  <h2 class="basket-empty">Här var det tomt</h2>

  <% } else { %>

<table>
  <thead>
    <tr>
      <th>Produkt</th>
      <th>Pris</th>
      <th>Totalt</th>
      <th>Antal</th>
    </tr>
  </thead>
  <tbody>

    <% products.forEach(product => { %>

      <tr>
        <td class="table-product"><%= product.name %></td>
        <td class="table-price"><%= product.price %> SEK</td>
        <td class="table-total"><%= product.total %> SEK</td>
        <td class="table-quantity">

        <div class="cart-selection">
          <form method="POST" action="/basket/update">
           <input type="hidden" name="productId" value="<%= product.id %>">

           <select name="quantity" onchange="this.form.submit()">

            <% for (let i = 1; i<= 10; i++) { %>

              <option value="<%= i %>" <%= product.quantity === i ? "selected" : "" %>><%= i %></option>

            <% } %>
          </select>
        </form>
        

        <form action="/basket/delete" method="POST">
          <input type="hidden" name="productId" value="<%= product.id %>">

          <button type="submit">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </form>
        </div>
      </td>
    </tr>


    <% }) %>
  </tbody>
</table>

<div class="cart-btn">
  <button>Till kassan</button>
</div>
<% } %>