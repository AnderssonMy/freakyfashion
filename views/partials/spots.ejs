<section class="spots">
    <% spots.forEach(spot => { %>
        <article class="spot">
            <a href="<%= spot.link %>">
                <img src="<%= spot.image %>" alt="<%= spot.description %>">
                <p class="spot-text"><%= spot.description %></p>
            </a>
        </article>
    <% }) %>
</section>
